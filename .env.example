# Leave both unset to run against the bundled mock backend (the default).
#
# Set these to talk to a real supermemory instance. They are server-only —
# the Next.js route handlers proxy and adapt shapes so the browser never
# sees the key and never hits the remote origin (CORS would block it).
#
# Copy to `.env.local` (gitignored) and fill in real values.

# The local binary's address, or https://api.supermemory.ai for hosted.
# SUPERMEMORY_URL=http://127.0.0.1:6767

# Optional: SSH target for ops docs / scripts (IP or MagicDNS hostname).
# SUPERMEMORY_SSH_HOST=127.0.0.1

# Printed once on the local server's first boot; also in ~/.supermemory/data/api-key.
# SUPERMEMORY_KEY=sm_your_key_here

# Optional: same-machine introspection.
#
# The Memory API publishes no runtime metadata — no version, uptime, model or
# storage endpoint — so Settings → Runtime and the Overview instance panel stay
# blank against a live instance. When the console runs on the same host as
# supermemory-server, point this at the server's install directory and those
# rows are read from disk instead:
#
#   <dir>/bin/supermemory-server.version   version
#   <dir>/env                              embedding + LLM configuration
#   $SUPERMEMORY_DATA_DIR (or <dir>)       storage engine, path and size
#
# Uptime comes from the running process. Provider API keys in <dir>/env are
# read only to tell which provider is configured; their values never leave the
# server. Leave unset when the console is deployed anywhere else.
# SUPERMEMORY_LOCAL_DIR=~/.supermemory
